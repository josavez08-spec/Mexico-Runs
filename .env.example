PORT=5000
DB_SERVER=localhost
DB_DATABASE=MexicoRuns2
DB_USER=sa
DB_PASSWORD=pon_aqui_tu_contrasena
# Para instancia con nombre, puedes usar DB_INSTANCE=SQLEXPRESS02
# O define DB_PORT si SQL Server escucha por un puerto TCP.

# Opcional: habilita enlaces de verificación por correo (usa contraseña de aplicación SMTP).
# No subas valores reales a Git ni compartas el archivo .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Escribe true solo después de configurar SMTP para exigir confirmación antes de reservar.
REQUIRE_VERIFIED_EMAIL=false
# Opcional: clave secreta compartida con el proveedor GPS que enviará actualizaciones HTTP.
GPS_INGEST_API_KEY=
